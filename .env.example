# URL pública de la aplicación desplegada en Vercel.
NEXT_PUBLIC_SITE_URL=https://tu-proyecto.vercel.app

# WhatsApp comercial: código de país y número, sin + ni espacios.
# Si no se configura, se usa 56951011687. Requiere un nuevo build al cambiarlo.
NEXT_PUBLIC_WHATSAPP_NUMBER=56951011687

# Supabase: valores públicos usados por la aplicación web.
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_reemplazar

# Supabase: valores exclusivos del servidor. Nunca los expongas en el navegador.
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SECRET_KEY=sb_secret_reemplazar

# Solo se necesita para aplicar migraciones desde la línea de comandos.
SUPABASE_DB_PASSWORD=reemplazar

# ID del único administrador, obtenido desde Supabase → Authentication → Users.
# Es una variable exclusiva del servidor; un correo nunca otorga privilegios.
ADMIN_USER_ID=uuid-del-administrador

# Formulario local /prueba-pago: solo funciona con next dev en localhost.
# Credenciales del vendedor ficticio de TOCA; nunca usar las de la empresa real.
# Solo se necesita si vuelves a usar campos de tarjeta integrados en TOCA.
MERCADOPAGO_TEST_PUBLIC_KEY=
MERCADOPAGO_TEST_ACCESS_TOKEN=

# Modo de Mercado Pago, independiente del despliegue: test funciona también en Production.
# off deshabilita el checkout. Los cobros reales todavía no están implementados.
# Usa el Supabase habitual de TOCA y la tabla checkout_test_attempts.
# Instrucciones completas: docs/checkout.md
TOCA_CHECKOUT_MODE=off
# Secreto aleatorio de al menos 32 caracteres. Solo servidor; conservar entre redeploys.
CHECKOUT_SESSION_SECRET=
# Opcional: origen HTTPS de un alias adicional al dominio NEXT_PUBLIC_SITE_URL y URLs de Vercel.
CHECKOUT_BASE_URL=
